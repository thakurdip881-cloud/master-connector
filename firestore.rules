rules_version = '2';
// =====================================================================
// MASTER CONNECTOR + DIP Master AI — एक ही Firebase के सुरक्षा नियम
// Firebase Console → Firestore Database → Rules में यह पूरा पेस्ट करके Publish करें।
//   • मालिक = OWNER_UID (आपका अकाउंट) — सब कुछ
//   • canEdit वाला एडमिन: कमांड, फ़ाइलें, DIP ON/OFF, ग्राहक
//   • वर्कर: अपनी ड्यूटी, अपने लिए आई कमांड, फ़ाइलें देखना
//   • नया वर्कर: DIP Control Panel के हायरिंग लिंक से खुद जुड़ता है
// =====================================================================
service cloud.firestore {
  match /databases/{db}/documents {

    function signed()   { return request.auth != null; }
    function isOwner()  { return signed() && request.auth.uid == 'Y7u25ODNNLOFBiiePyM7oR7Ts6n2'; }
    function userDoc(u) { return /databases/$(db)/documents/users/$(u); }
    function me()       { return get(userDoc(request.auth.uid)).data; }
    function active()   { return isOwner() || (signed() && exists(userDoc(request.auth.uid)) && me().active != false); }
    function editor()   { return isOwner() || (active() && me().canEdit == true); }
    function inviteDoc(c)  { return /databases/$(db)/documents/invites/$(c); }
    function inviteOpen(c) { return exists(inviteDoc(c)) && get(inviteDoc(c)).data.used == false && get(inviteDoc(c)).data.exp > request.time; }

    // ---------- यूज़र्स ----------
    match /users/{uid} {
      allow read: if (signed() && request.auth.uid == uid) || editor();
      allow create: if (isOwner() && (uid == request.auth.uid || request.resource.data.role != 'admin'))
        // नया वर्कर हायरिंग लिंक से — लिंक वाली भूमिका ही, बदलाव की अनुमति नहीं
        || (signed() && request.auth.uid == uid && !exists(userDoc(uid))
          && request.resource.data.keys().hasOnly(['name', 'email', 'mobile', 'role', 'canEdit', 'active', 'status', 'shift', 'invite', 'createdAt'])
          && request.resource.data.invite is string && inviteOpen(request.resource.data.invite)
          && request.resource.data.role == get(inviteDoc(request.resource.data.invite)).data.role
          && request.resource.data.canEdit == false
          // पुराना (DIP Control Panel) लिंक: सीधे चालू; नया WhatsApp फ़ॉर्म: मंज़ूरी बाकी
          && (request.resource.data.active == true || (request.resource.data.active == false && request.resource.data.status == 'pending'))
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && getAfter(inviteDoc(request.resource.data.invite)).data.usedBy == uid);
      allow update: if isOwner() && (uid == request.auth.uid || request.resource.data.role != 'admin');
      allow delete: if isOwner() && uid != request.auth.uid;
    }

    // ---------- KYC (जन्म तिथि, ईमेल, ID, लाइव फ़ोटो) — सिर्फ़ मालिक और वो खुद देख सके ----------
    match /kyc/{uid} {
      allow read: if isOwner() || (signed() && request.auth.uid == uid);
      allow create: if signed() && request.auth.uid == uid && !exists(/databases/$(db)/documents/kyc/$(uid))
        && getAfter(userDoc(uid)).data.invite is string
        && request.resource.data.keys().hasOnly(['uid', 'name', 'mobile', 'dob', 'mail', 'mailVerified', 'pw', 'hours', 'trial', 'tg', 'addr', 'home', 'idType', 'idNo', 'idImg', 'selfie', 'consent', 'ua', 'at'])
        && request.resource.data.uid == uid && request.resource.data.consent == true
        && request.resource.data.idType in ['aadhaar', 'pan', 'voter', 'dl']
        && request.resource.data.idImg is string && request.resource.data.idImg.size() < 400000
        && request.resource.data.selfie is string && request.resource.data.selfie.size() < 300000
        && (request.resource.data.idType != 'aadhaar' || request.resource.data.idNo == '' || request.resource.data.idNo.matches('XXXX-XXXX-[0-9]{4}'));
      allow update: if false;
      allow delete: if isOwner();
    }

    // ---------- KYC लाइव वीडियो (30 सेकंड, छोटा) — सिर्फ़ मालिक और वो खुद ----------
    match /kycVideo/{uid} {
      allow read: if isOwner() || (signed() && request.auth.uid == uid);
      allow create: if signed() && request.auth.uid == uid && !exists(/databases/$(db)/documents/kycVideo/$(uid))
        && getAfter(userDoc(uid)).data.invite is string
        && request.resource.data.keys().hasOnly(['uid', 'vid', 'secs', 'at'])
        && request.resource.data.uid == uid
        && request.resource.data.vid is string && request.resource.data.vid.size() < 1000000;
      allow update: if false;
      allow delete: if isOwner();
    }

    // ---------- ड्यूटी में फ़ोन से दूर होने पर 5 मिनट की रिकॉर्डिंग (टुकड़ों में) — वर्कर सिर्फ़ अपनी बना सके, देखे एडमिन ----------
    match /dutyVid/{id} {
      allow read: if editor();
      allow create: if active() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'duty', 'rec', 'i', 'n', 'part', 'at'])
        && request.resource.data.part is string && request.resource.data.part.size() < 800000;
      allow update: if false;
      allow delete: if isOwner();
    }

    // ---------- वर्कर की काम की रिपोर्ट (हर 12 घंटे) — वर्कर अपनी भेजे/देखे, एडमिन सब देखे ----------
    match /reports/{id} {
      allow read: if editor() || (signed() && resource.data.uid == request.auth.uid);
      allow create: if active() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'mobile', 'text', 'cnt', 'amt', 'note', 'mail', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 600;
      allow update: if false;
      allow delete: if isOwner();
    }

    // ---------- 90 दिन वाली अपने-आप सफ़ाई की जानकारी (सिर्फ़ सर्वर लिखता है) ----------
    match /meta/{d} { allow read: if isOwner(); allow write: if false; }

    // ---------- ड्यूटी (हाज़िरी + 30 km location जाँच) ----------
    match /duty/{id} {
      allow read: if editor() || (active() && resource.data.uid == request.auth.uid);
      allow create: if active() && request.resource.data.uid == request.auth.uid && request.resource.data.end == null;
      allow update: if editor() || (active() && resource.data.uid == request.auth.uid && resource.data.end == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['end', 'lastLat', 'lastLng', 'awayKm', 'lastAt', 'startLat', 'startLng', 'idleAlert', 'idleAt', 'chkAt', 'chkImg', 'vidRec', 'watchAt', 'scrOff', 'scrOn']));
      allow delete: if isOwner();
    }

    // ---------- कमांड बोर्ड ----------
    match /commands/{id} {
      allow read: if editor() || (active() && (resource.data.to == 'all' || resource.data.to == request.auth.uid));
      allow create: if editor() && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.to is string;
      allow update: if false;
      allow delete: if editor();
    }
    // जवाब: id = कमांडID_यूज़रID (देख लिया / हो गया)
    match /acks/{id} {
      allow read: if editor() || (signed() && resource.data.uid == request.auth.uid);
      allow create, update: if active() && id == request.resource.data.cmd + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['seen', 'done'];
      allow delete: if editor();
    }

    // ---------- हायरिंग लिंक (लंबा random code, एक बार चलता है) ----------
    match /invites/{code} {
      allow get: if true;
      allow list, delete: if editor();
      allow create: if editor() && code.size() >= 16
        && request.resource.data.role in ['worker', 'trainee']
        && request.resource.data.used == false && request.resource.data.exp is timestamp;
      allow update: if signed() && resource.data.used == false && resource.data.exp > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true && request.resource.data.usedBy == request.auth.uid
        && !exists(userDoc(request.auth.uid))
        && existsAfter(userDoc(request.auth.uid)) && getAfter(userDoc(request.auth.uid)).data.invite == code;
    }

    // ---------- फ़ाइलें / लिंक ----------
    match /files/{id} { allow read: if active(); allow write: if editor(); }
    // फ़ोन से अपलोड की गई फ़ाइल के टुकड़े (हर टुकड़ा ~700KB)
    match /fileChunks/{id} { allow read: if active(); allow write: if editor(); }

    // ---------- DIP Master AI ----------
    // ON/OFF और मैसेज DIP साइट बिना login पढ़ती है — इसमें कोई गुप्त चीज़ न रखें
    match /dip/control { allow read: if true; allow write: if editor(); }
    // हर फ़ोन का रिकॉर्ड: पहली बार खुलने का समय (7 दिन फ़्री ट्रायल) — फ़ोन खुद सिर्फ़ एक बार firstSeen बना सकता है
    match /dipDevices/{d} {
      allow get: if true;
      allow list: if editor();
      allow create: if editor() || (d.matches('DIP-[A-Z0-9]{8}') && request.resource.data.keys().hasOnly(['firstSeen'])
        && request.resource.data.firstSeen == request.time);
      allow update, delete: if editor();
    }
    match /dipCustomers/{id} { allow read, write: if editor(); }
    // ट्रायल खत्म स्क्रीन वाला फ़ॉर्म: ग्राहक सिर्फ़ अपनी Device ID पर अर्ज़ी भेज/बदल सकता है, पढ़ना सिर्फ़ एडमिन
    match /dipPlanReq/{d} {
      allow read, delete: if editor();
      allow create, update: if editor() || (d.matches('DIP-[A-Z0-9]{8}')
        && request.resource.data.keys().hasOnly(['name','mobile','plan','at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.mobile is string && request.resource.data.mobile.matches('[6-9][0-9]{9}')
        && request.resource.data.plan in [30, 90, 180]
        && request.resource.data.at == request.time);
    }

    // ---------- 🧳 DIP Tour & Travels ग्राहक (वर्कर से अलग डेटा) ----------
    function tCust() { return signed() && request.auth.token.email is string && request.auth.token.email.matches('.*@customer[.]diptour[.]app'); }
    match /tour/config { allow read: if true; allow write: if editor(); }
    match /tCustomers/{uid} {
      // वर्कर सिर्फ़ अपने link (ref) से जुड़े ग्राहक देख सके
      allow read: if editor() || (tCust() && request.auth.uid == uid) || (active() && resource.data.ref == request.auth.uid);
      allow create: if tCust() && request.auth.uid == uid && !exists(/databases/$(db)/documents/tCustomers/$(uid))
        && request.resource.data.keys().hasOnly(['uid', 'name', 'mobile', 'wa', 'mail', 'tg', 'idType', 'idNo', 'consent', 'at', 'ref'])
        && (!('ref' in request.resource.data) || (request.resource.data.ref is string && request.resource.data.ref.size() < 64 && exists(userDoc(request.resource.data.ref))))
        && request.resource.data.uid == uid && request.resource.data.consent == true
        && (request.resource.data.idType != 'aadhaar' || request.resource.data.idNo.matches('XXXX-XXXX-[0-9]{4}'));
      allow update: if editor();
      allow delete: if isOwner();
    }
    match /tMsgs/{id} {
      allow read: if editor() || (tCust() && resource.data.uid == request.auth.uid);
      allow create: if (editor() && request.resource.data.from == 'a')
        || (tCust() && request.resource.data.uid == request.auth.uid && request.resource.data.from == 'c'
            && request.resource.data.keys().hasOnly(['uid', 'from', 'text', 'at']) && request.resource.data.text.size() <= 500);
      allow update: if false;
      allow delete: if isOwner();
    }
    match /tNotice/{id} { allow read: if editor() || tCust(); allow write: if editor(); }
    match /tTxn/{id} {
      allow read: if editor() || (tCust() && resource.data.uid == request.auth.uid);
      allow write: if editor();
    }
    match /tDocs/{id} {
      allow read: if editor() || (tCust() && resource.data.uid == request.auth.uid);
      allow create: if tCust() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'img', 'at']) && request.resource.data.img.size() < 750000;
      allow update: if false;
      allow delete: if isOwner() || (tCust() && resource.data.uid == request.auth.uid);
    }

    // ---------- 🧳 ग्राहक follow-up — वर्कर सिर्फ़ अपने ग्राहक का लिखे/देखे, मालिक सब देखे ----------
    match /followups/{id} {
      allow read: if editor() || (active() && resource.data.uid == request.auth.uid);
      allow create: if active() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'wname', 'cust', 'cname', 'note', 'next', 'at'])
        && request.resource.data.note is string && request.resource.data.note.size() > 0 && request.resource.data.note.size() <= 300
        && request.resource.data.cust is string && request.resource.data.next is string && request.resource.data.next.size() <= 10
        && (editor() || get(/databases/$(db)/documents/tCustomers/$(request.resource.data.cust)).data.ref == request.auth.uid);
      allow update: if false;
      allow delete: if isOwner();
    }

    // ---------- 🖥️ वर्कर की स्क्रीन (हर 10 मिनट + "अभी देखें") — वर्कर सिर्फ़ अपनी भेजे, देखे मालिक ----------
    match /screens/{uid} {
      allow read: if editor() || (signed() && request.auth.uid == uid);
      allow create, update: if active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'img', 'at', 'src'])
        && request.resource.data.uid == uid && request.resource.data.img is string && request.resource.data.img.size() < 400000;
      allow delete: if isOwner();
    }
    match /screenReq/{uid} {
      allow read: if editor() || (signed() && request.auth.uid == uid);
      allow write: if editor();
    }

    // ---------- 💻 लैपटॉप/PC पर काम की अनुमति — वर्कर माँगे (30 सेकंड वीडियो के साथ), मालिक दे ----------
    match /devReq/{uid} {
      allow read: if editor() || (signed() && request.auth.uid == uid);
      allow create, update: if editor() || (active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'dev', 'ua', 'status', 'at', 'rec'])
        && request.resource.data.uid == uid && request.resource.data.status == 'pending');
      allow delete: if editor();
    }

    // ---------- 🗄️ 30% Partner ऑनलाइन बैकअप — हर खाता सिर्फ़ अपना एक डिब्बा (कोई दूसरा नहीं देख सकता) ----------
    match /partnerBackup/{uid} {
      allow read, delete: if signed() && request.auth.uid == uid;
      allow create, update: if active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['app', 'v', 'at', 'n', 'data'])
        && request.resource.data.data is string && request.resource.data.data.size() < 300000;
    }

    // ---------- 🆘 वर्कर की अर्ज़ी: पासवर्ड भूल गए / मोबाइल नंबर बदला (बिना लॉगिन भेज सके, पढ़े सिर्फ़ एडमिन) ----------
    match /help/{id} {
      allow read, delete: if editor();
      allow create, update: if editor() || (
        request.resource.data.keys().hasOnly(['type', 'name', 'mobile', 'newMobile', 'at'])
        && request.resource.data.type in ['pw', 'mob']
        && request.resource.data.mobile is string && request.resource.data.mobile.matches('[6-9][0-9]{9}')
        && id == request.resource.data.type + '_' + request.resource.data.mobile
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.newMobile is string
        && (request.resource.data.type == 'pw' || request.resource.data.newMobile.matches('[6-9][0-9]{9}'))
        && request.resource.data.at == request.time);
    }

    // ---------- 📜 बदलाव का रिकॉर्ड (कौन, क्या, कब) — एडमिन लिखे, मालिक पढ़े/वापस ले ----------
    match /audit/{id} {
      allow read: if editor();
      allow create: if editor() && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow update: if isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['undone']);
      allow delete: if isOwner();
    }

    // ---------- 🔒 वर्कर के पासवर्ड — सिर्फ़ मालिक (एडमिन अनुमति वाले भी नहीं) ----------
    match /secrets/{uid} { allow read, write: if isOwner(); }
    // 🔁 नया पासवर्ड माँगना — सिर्फ़ मालिक (GitHub का सुरक्षित काम हर 30 मिनट पूरा करता है)
    match /pwreset/{uid} { allow read, write: if isOwner(); }

    // बाकी सब बंद
    match /{document=**} { allow read, write: if false; }
  }
}
