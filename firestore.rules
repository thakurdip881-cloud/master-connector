rules_version = '2';
// =====================================================================
// MASTER CONNECTOR + DIP Master AI — एक ही Firebase के सुरक्षा नियम
// Firebase Console → Firestore Database → Rules में यह पूरा पेस्ट करके Publish करें।
//   • मालिक = OWNER_UID (आपका अकाउंट) — सब कुछ
//   • canEdit वाला एडमिन: कमांड, फ़ाइलें, DIP ON/OFF, ग्राहक
//   • वर्कर: अपनी ड्यूटी, अपने लिए आई कमांड, फ़ाइलें देखना
//   • नया वर्कर: DIP Control Panel के हायरिंग लिंक से खुद जुड़ता है
// =====================================================================
service cloud.firestore {
  match /databases/{db}/documents {

    function signed()   { return request.auth != null; }
    function isOwner()  { return signed() && request.auth.uid == 'Y7u25ODNNLOFBiiePyM7oR7Ts6n2'; }
    function userDoc(u) { return /databases/$(db)/documents/users/$(u); }
    function me()       { return get(userDoc(request.auth.uid)).data; }
    function active()   { return isOwner() || (signed() && exists(userDoc(request.auth.uid)) && me().active != false); }
    function editor()   { return isOwner() || (active() && me().canEdit == true); }
    function inviteDoc(c)  { return /databases/$(db)/documents/invites/$(c); }
    function inviteOpen(c) { return exists(inviteDoc(c)) && get(inviteDoc(c)).data.used == false && get(inviteDoc(c)).data.exp > request.time; }

    // ---------- यूज़र्स ----------
    match /users/{uid} {
      allow read: if (signed() && request.auth.uid == uid) || editor();
      allow create: if (isOwner() && (uid == request.auth.uid || request.resource.data.role != 'admin'))
        // नया वर्कर हायरिंग लिंक से — लिंक वाली भूमिका ही, बदलाव की अनुमति नहीं
        || (signed() && request.auth.uid == uid && !exists(userDoc(uid))
          && request.resource.data.keys().hasOnly(['name', 'email', 'mobile', 'role', 'canEdit', 'active', 'status', 'shift', 'invite', 'createdAt'])
          && request.resource.data.invite is string && inviteOpen(request.resource.data.invite)
          && request.resource.data.role == get(inviteDoc(request.resource.data.invite)).data.role
          && request.resource.data.canEdit == false
          // पुराना (DIP Control Panel) लिंक: सीधे चालू; नया WhatsApp फ़ॉर्म: मंज़ूरी बाकी
          && (request.resource.data.active == true || (request.resource.data.active == false && request.resource.data.status == 'pending'))
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && getAfter(inviteDoc(request.resource.data.invite)).data.usedBy == uid);
      allow update: if isOwner() && (uid == request.auth.uid || request.resource.data.role != 'admin');
      allow delete: if isOwner() && uid != request.auth.uid;
    }

    // ---------- KYC (जन्म तिथि, ईमेल, ID, लाइव फ़ोटो) — सिर्फ़ मालिक और वो खुद देख सके ----------
    match /kyc/{uid} {
      allow read: if isOwner() || (signed() && request.auth.uid == uid);
      allow create: if signed() && request.auth.uid == uid && !exists(/databases/$(db)/documents/kyc/$(uid))
        && getAfter(userDoc(uid)).data.invite is string
        && request.resource.data.keys().hasOnly(['uid', 'name', 'mobile', 'dob', 'mail', 'mailVerified', 'pw', 'idType', 'idNo', 'idImg', 'selfie', 'consent', 'ua', 'at'])
        && request.resource.data.uid == uid && request.resource.data.consent == true
        && request.resource.data.idType in ['aadhaar', 'pan', 'voter', 'dl']
        && request.resource.data.idImg is string && request.resource.data.idImg.size() < 400000
        && request.resource.data.selfie is string && request.resource.data.selfie.size() < 300000
        && (request.resource.data.idType != 'aadhaar' || request.resource.data.idNo.matches('XXXX-XXXX-[0-9]{4}'));
      allow update: if false;
      allow delete: if isOwner();
    }

    // ---------- ड्यूटी (हाज़िरी + 2 km location जाँच) ----------
    match /duty/{id} {
      allow read: if editor() || (active() && resource.data.uid == request.auth.uid);
      allow create: if active() && request.resource.data.uid == request.auth.uid && request.resource.data.end == null;
      allow update: if editor() || (active() && resource.data.uid == request.auth.uid && resource.data.end == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['end', 'lastLat', 'lastLng', 'awayKm', 'lastAt', 'startLat', 'startLng']));
      allow delete: if isOwner();
    }

    // ---------- कमांड बोर्ड ----------
    match /commands/{id} {
      allow read: if editor() || (active() && (resource.data.to == 'all' || resource.data.to == request.auth.uid));
      allow create: if editor() && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.to is string;
      allow update: if false;
      allow delete: if editor();
    }
    // जवाब: id = कमांडID_यूज़रID (देख लिया / हो गया)
    match /acks/{id} {
      allow read: if editor() || (signed() && resource.data.uid == request.auth.uid);
      allow create, update: if active() && id == request.resource.data.cmd + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['seen', 'done'];
      allow delete: if editor();
    }

    // ---------- हायरिंग लिंक (लंबा random code, एक बार चलता है) ----------
    match /invites/{code} {
      allow get: if true;
      allow list, delete: if editor();
      allow create: if editor() && code.size() >= 16
        && request.resource.data.role in ['worker', 'trainee']
        && request.resource.data.used == false && request.resource.data.exp is timestamp;
      allow update: if signed() && resource.data.used == false && resource.data.exp > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true && request.resource.data.usedBy == request.auth.uid
        && !exists(userDoc(request.auth.uid))
        && existsAfter(userDoc(request.auth.uid)) && getAfter(userDoc(request.auth.uid)).data.invite == code;
    }

    // ---------- फ़ाइलें / लिंक ----------
    match /files/{id} { allow read: if active(); allow write: if editor(); }

    // ---------- DIP Master AI ----------
    // ON/OFF और मैसेज DIP साइट बिना login पढ़ती है — इसमें कोई गुप्त चीज़ न रखें
    match /dip/control { allow read: if true; allow write: if editor(); }
    // हर फ़ोन का रिकॉर्ड: पहली बार खुलने का समय (7 दिन फ़्री ट्रायल) — फ़ोन खुद सिर्फ़ एक बार firstSeen बना सकता है
    match /dipDevices/{d} {
      allow get: if true;
      allow list: if editor();
      allow create: if editor() || (d.matches('DIP-[A-Z0-9]{8}') && request.resource.data.keys().hasOnly(['firstSeen'])
        && request.resource.data.firstSeen == request.time);
      allow update, delete: if editor();
    }
    match /dipCustomers/{id} { allow read, write: if editor(); }
    // ट्रायल खत्म स्क्रीन वाला फ़ॉर्म: ग्राहक सिर्फ़ अपनी Device ID पर अर्ज़ी भेज/बदल सकता है, पढ़ना सिर्फ़ एडमिन
    match /dipPlanReq/{d} {
      allow read, delete: if editor();
      allow create, update: if editor() || (d.matches('DIP-[A-Z0-9]{8}')
        && request.resource.data.keys().hasOnly(['name','mobile','plan','at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.mobile is string && request.resource.data.mobile.matches('[6-9][0-9]{9}')
        && request.resource.data.plan in [30, 90, 180]
        && request.resource.data.at == request.time);
    }

    // बाकी सब बंद
    match /{document=**} { allow read, write: if false; }
  }
}
